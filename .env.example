# ══════════════════════════════════════════════════════════════════
# Limiance Frontend Admin — Environment Template (.env.example)
# ══════════════════════════════════════════════════════════════════

# Environment mode: "development" | "staging" | "production"
# Controls the status badge in the topbar and logging severity.
VITE_APP_ENV=development

# Base URL for the Admin Service backend API:
# - Leave EMPTY in local dev so Vite forwards /api to localhost:4000
# - In staging/production, set to "/api" (reverse-proxied) or full URL (e.g. "https://api-admin.limiance.com")
VITE_API_BASE_URL=
